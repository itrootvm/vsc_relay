[Unit]
Description=VS Code Agent Relay (Telegram control for Claude Code in VS Code)
Documentation=https://github.com/itrootvm/vsc_relay
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/vsc-relay/relay.env
ExecStart=%h/.local/bin/vsc-relay-agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
